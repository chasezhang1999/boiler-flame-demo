# 生成图片和报告页的对外地址前缀
BASE_URL=https://flame.518521.xyz

# Dify 工作流（分析链路）。在 Dify 应用的「访问 API」页生成。
# 同机部署时走容器网络直连它的 nginx，不绕公网和 Cloudflare。
DIFY_BASE=http://docker-nginx-1/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxx

# 历史问答用的模型，直接调，不经 Dify
LLM_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4-flash-vision-exp

# 历史问答 chatflow 的 key（导入 dify/chat.yml 后在该应用的「访问 API」页生成）
# 不填则问答退回直连模型，功能一样但工作流画布上看不到
DIFY_CHAT_KEY=
