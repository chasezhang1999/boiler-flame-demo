{# 拍照分析的共用逻辑。手机版和网页版版式不同，但元素 id 一致，脚本只此一份。
   引用它的页面必须提供：#site #cam #pick #preview #vp-empty #vp-site #vp-state
   #stages(.st + #bar) #act-idle #act-preview #act-busy(#remain) #result #verdict
   #btn-report #archived #err #summary #recent #btn-go #btn-reset
   可选：#btn-shot #btn-pick #drop #}
<script>
const SITES = {{ sites|tojson }};

let file = null, timer = null, t0 = 0;

function siteId(){ return $('#site').value; }
function siteLabel(){
  const s = SITES.find(x => x.id === siteId());
  return s ? s.label : '未选择机位';
}
function showErr(m){ const e = $('#err'); e.textContent = m || ''; e.hidden = !m; }

function onSite(){
  const el = $('#vp-site');
  if(el) el.textContent = siteLabel();
  loadRecent();
}

async function loadRecent(){
  const box = $('#recent');
  if(!box) return;
  const id = siteId();
  if(!id){ box.innerHTML = '<div class="muted">选择机位后显示。</div>'; return; }
  box.innerHTML = '<div class="muted">加载中…</div>';
  try{
    const j = await api('/api/history?' + new URLSearchParams({site:id, days:0, limit:3}));
    if(!j.rows.length){ box.innerHTML = '<div class="muted">这个机位还没有记录。</div>'; return; }
    box.innerHTML = j.rows.map(r =>
      '<div class="r"><span class="tnum" style="color:var(--n700)">' + esc(r.ts.slice(5,16)) + '</span>' +
      '<span><span class="lv ' + esc(r.risk_level||'未知') + '">' + esc(r.risk_level||'未知') + '</span></span>' +
      '<span class="t">' + esc(r.headline||'—') + '</span>' +
      (r.report_url ? '<a href="' + esc(r.report_url) + '" target="_blank" style="font-size:12px">报告</a>'
                    : '<span class="muted">—</span>') +
      '</div>').join('');
  }catch(e){ box.innerHTML = '<div class="muted">读取失败：' + esc(e.message) + '</div>'; }
}

function setPhase(p){
  $('#act-idle').hidden    = p !== 'idle';
  $('#act-preview').hidden = p !== 'preview';
  $('#act-busy').hidden    = p !== 'busy';
  $('#result').hidden      = p !== 'done';
  $('#stages').hidden      = p !== 'busy';
  const st = $('#vp-state');
  if(st) st.textContent = {idle:'待取像', preview:'已取像', busy:'分析中', done:'已归档'}[p];
}

// 手机直出照片是 4000×3000、五百 KB 起步，传上去服务器还得按原尺寸跑一遍 CV。
// 长边压到 1600 看火焰形态完全够，实测服务端 CV 从 220ms 降到 40ms 上下，
// 上传流量也少四分之三 —— 现场几百人同时扫码时，这一条比什么都管用。
const MAX_EDGE = 1600;

async function shrink(f){
  if(!f || !/^image\//.test(f.type)) return f;
  let bmp = null;
  try{
    // from-image 让浏览器按 EXIF 摆正，否则竖着拍的照片会躺下
    bmp = await createImageBitmap(f, {imageOrientation:'from-image'});
    const scale = Math.min(1, MAX_EDGE / Math.max(bmp.width, bmp.height));
    if(scale === 1 && f.size < 600*1024) return f;      // 本来就不大，别折腾
    const w = Math.round(bmp.width*scale), h = Math.round(bmp.height*scale);
    const cv = document.createElement('canvas');
    cv.width = w; cv.height = h;
    cv.getContext('2d').drawImage(bmp, 0, 0, w, h);
    const blob = await new Promise(r => cv.toBlob(r, 'image/jpeg', 0.85));
    if(!blob || blob.size >= f.size) return f;           // 没压小就用原图
    const name = (f.name || 'photo').replace(/\.\w+$/, '') + '.jpg';
    return new File([blob], name, {type:'image/jpeg'});
  }catch(e){
    return f;   // 压缩挂了就原样上传。现场宁可慢一点，不能因为这个报错
  }finally{
    if(bmp) bmp.close();
  }
}

let previewUrl = '';

async function onPicked(f){
  if(!f) return;
  $('#vp-empty').hidden = true;
  $('#summary').hidden = true;
  showErr('');
  const st = $('#vp-state');
  if(st) st.textContent = '处理中';

  file = await shrink(f);

  const img = $('#preview');
  if(previewUrl) URL.revokeObjectURL(previewUrl);   // 连换几张时别把内存漏掉
  previewUrl = URL.createObjectURL(file);
  img.src = previewUrl;
  img.hidden = false;
  setPhase('preview');
}

// 进度是按经验耗时推进的估计值，不是后端回调——一次 blocking 调用拿不到中间态，
// 但等待期完全没反馈更糟。四段合计约 20 秒，跑完停在最后一段等真结果。
// 四段的时间点按实测校准：照片校验约 3s（不是火焰的话就停在这儿了），
// CV 很快，判级是模型调用约 4.5s，出报告落台账约 1s。整条链路单次约 10~14 秒。
// 原来写死 20 秒是初版的估计，实测下来偏长，进度条会在最后一段干等。
const STAGE_MARKS = [3, 5, 10, 14];
const STAGE_TOTAL = STAGE_MARKS[STAGE_MARKS.length - 1];

function startStages(){
  t0 = Date.now();
  // 每次都把这行重建：超时那段会整个换掉文字，#remain 会被连带删掉，
  // 不复原的话第二次分析就取不到它了
  $('#busy-text').innerHTML = '分析中 · 剩余约 <b id="remain">' + STAGE_TOTAL + '</b> 秒';
  $$('#stages .st').forEach(el => { el.className = 'st'; el.lastElementChild.textContent = '待执行'; });
  timer = setInterval(() => {
    const el = (Date.now() - t0) / 1000;
    // 超过估计值就别再报假的剩余秒数了。原来会一直卡在「剩余约 1 秒」——
    // 现场并发高时实测要等三十几秒，盯着那个「1 秒」看半分钟很难受。
    if(el > STAGE_TOTAL){
      $('#busy-text').textContent = '分析中 · 前面还有排队，已等 ' + Math.round(el) + ' 秒';
    } else {
      $('#remain').textContent = Math.max(1, Math.round(STAGE_TOTAL - el));
    }
    let cur = STAGE_MARKS.findIndex(m => el < m);
    if(cur === -1) cur = STAGE_MARKS.length - 1;
    $$('#stages .st').forEach((n, i) => {
      n.className = 'st' + (i < cur ? ' done' : i === cur ? ' on' : '');
      n.lastElementChild.textContent = i < cur ? STAGE_MARKS[i] + 's' : i === cur ? '进行中' : '待执行';
    });
    $('#bar').style.width = Math.min(96, 8 + el / STAGE_TOTAL * 88) + '%';
  }, 300);
}
function stopStages(){ clearInterval(timer); timer = null; }

// 工作流第一步「照片校验」判定不是炉膛火焰时，会带这个等级回来，
// 后面的 CV、判级、出报告、落台账全都没跑。见 tools/build_workflow.py 的 REJECT_CODE。
const REJECTED = '未分析';

// 被挡下时不能照着正常结论的样子渲染 —— 那会显示成「未分析风险」这种病句，
// 还会打出「已存入台账」，而台账里其实什么都没有。
function showRejected(j){
  $('#verdict').innerHTML =
    '<div class="top">' +
      '<div class="badge" style="background:var(--n600)">未识别</div>' +
      '<div class="mid"><div style="font-family:var(--h);font-size:17px;line-height:1.15">' +
        '这不是炉膛火焰照片</div>' +
      '<div style="font-size:11px;color:var(--n600);margin-top:2px" class="tnum">' +
        '停在第 1 步「照片校验」· 用时 ' + ((Date.now() - t0)/1000).toFixed(1) + ' 秒' +
        ' · 后续步骤未执行</div></div>' +
    '</div>';
  $('#btn-report').hidden = true;
  // 网页版把「查看报告 / 打印」整行藏掉 —— 打印一张「这不是火焰照片」没有意义。
  // 手机版没有这一行，取不到就跳过。
  const row = $('#act-report');
  if(row) row.hidden = true;
  $('#archived').textContent = '本次未进台账。换一张炉膛火焰照片再试。';
  if(j.summary){ $('#summary').innerHTML = corners() + md2html(j.summary); $('#summary').hidden = false; }
  setPhase('done');
  // setPhase 会把取景框角标写成「已归档」，这里同样不能这么说
  const st = $('#vp-state');
  if(st) st.textContent = '未识别';
}

function showResult(j){
  const lv = j.risk_level || '未知';
  if(lv === REJECTED){ showRejected(j); return; }
  // 上一次可能是被拒的，那时把这一行藏了，正常出结论要放回来
  const row = $('#act-report');
  if(row) row.hidden = false;
  $('#verdict').innerHTML =
    '<div class="top">' +
      '<div class="badge ' + esc(lv) + '" style="background:' +
        ({'高':'var(--hi)','中':'var(--mid)','低':'var(--lo)'}[lv] || 'var(--n600)') + '">' + esc(lv) + '风险</div>' +
      '<div class="mid"><div style="font-family:var(--h);font-size:17px;line-height:1.15">' +
        esc(siteLabel()) + '</div>' +
      '<div style="font-size:11px;color:var(--n600);margin-top:2px" class="tnum">' +
        new Date().toLocaleString('zh-CN', {hour12:false}).slice(0,16) +
        ' · 用时 ' + ((Date.now() - t0)/1000).toFixed(1) + ' 秒</div></div>' +
    '</div>';
  const a = $('#btn-report');
  if(j.report_url){ a.href = j.report_url; a.hidden = false; } else { a.hidden = true; }
  $('#archived').textContent = '已存入台账 · ' + siteLabel();
  if(j.summary){ $('#summary').innerHTML = corners() + md2html(j.summary); $('#summary').hidden = false; }
  setPhase('done');
  loadRecent();
}

function reset(){
  file = null; stopStages();
  if(previewUrl){ URL.revokeObjectURL(previewUrl); previewUrl = ''; }
  $('#preview').hidden = true; $('#preview').removeAttribute('src');
  $('#vp-empty').hidden = false; $('#summary').hidden = true;
  $('#cam').value = ''; $('#pick').value = '';
  showErr(''); setPhase('idle');
}

async function analyze(){
  const id = siteId();
  if(!id){ showErr('请先选择机组 / 位置——台账要按它归档。'); return; }
  if(!file){ showErr('还没有照片。'); return; }
  showErr('');
  setPhase('busy');
  startStages();
  try{
    const fd = new FormData();
    fd.append('file', file);
    fd.append('site', id);
    const j = await api('/api/analyze', {method:'POST', body:fd});
    stopStages();
    showResult(j);
  }catch(e){
    stopStages();
    setPhase('preview');
    showErr('分析失败：' + e.message);
  }
}

if($('#btn-shot')) $('#btn-shot').onclick = () => $('#cam').click();
if($('#btn-pick')) $('#btn-pick').onclick = () => $('#pick').click();
$('#cam').onchange  = e => onPicked(e.target.files[0]);
$('#pick').onchange = e => onPicked(e.target.files[0]);
$('#btn-go').onclick = analyze;
$('#btn-reset').onclick = reset;
$('#site').onchange = onSite;

// 网页版的拖放区（手机版没有 #drop，跳过）
const drop = $('#drop');
if(drop){
  drop.onclick = () => $('#pick').click();
  ['dragenter','dragover'].forEach(ev => drop.addEventListener(ev, e => {
    e.preventDefault(); drop.classList.add('over');
  }));
  ['dragleave','drop'].forEach(ev => drop.addEventListener(ev, e => {
    e.preventDefault(); drop.classList.remove('over');
  }));
  drop.addEventListener('drop', e => onPicked(e.dataTransfer.files[0]));
  // 直接粘贴截图也能进来，值长在电脑上常用
  window.addEventListener('paste', e => {
    const it = Array.from(e.clipboardData.files || [])[0];
    if(it) onPicked(it);
  });
}

onSite();
setPhase('idle');
</script>
