{% extends "base.html.j2" %}
{% set page = "capture" %}
{% block title %}拍照分析 · 炉智检{% endblock %}

{% block head %}
<style>
  /* 网页版：左右等宽对称。左边取像，右边结论 —— 中缝在正 50%。
     之前右栏钉死 340px，报告摘要里的表格和条形图全挤成一条，才改成 1:1。 */
  .cap{display:grid;grid-template-columns:1fr 1fr;align-items:start;min-height:calc(100vh - 51px)}
  .pane{padding:40px 48px 52px;display:flex;flex-direction:column;align-items:center;gap:24px;
        min-height:calc(100vh - 51px)}
  /* 栏本身撑满一半，内容居中并限宽 —— 超宽屏上两栏内容仍以中缝为轴对称 */
  .pane>*{width:100%;max-width:840px}
  .left{border-right:1px solid var(--line)}
  .right{position:sticky;top:51px;max-height:calc(100vh - 51px);overflow:auto}

  /* 两栏的标题块等高，中缝两侧的横向节奏才对得齐 */
  .phead{min-height:92px}
  .phead h2{font-size:30px;margin:6px 0 0}
  .hint{font-size:12px;color:var(--n600);text-wrap:pretty;max-width:56ch}

  .fields{display:grid;grid-template-columns:minmax(220px,1fr) auto auto;gap:10px;align-items:end}
  .viewport{aspect-ratio:4/3}
  #drop{cursor:pointer}
  #drop.over{border-color:var(--accent);background:var(--accent-100)}

  .card{padding:18px 20px;background:var(--bg)}
  /* 结论未出时的占位：#result 一旦显示就把它藏掉，不用另写 JS */
  #result:not([hidden]) ~ #ph{display:none}
  #ph{border:1px dashed var(--line);padding:34px 20px;text-align:center;color:var(--n600);
      display:flex;flex-direction:column;gap:6px;align-items:center}
  #ph b{font-family:var(--h);font-size:16px;color:var(--n700);font-weight:600}
  .switch a{font-size:12px;color:var(--n600);text-decoration:none;border-bottom:1px solid var(--line)}
  /* 量程条 `▬▬▮···` 断行就读不出来了，这一列钉死不换行 */
  #summary td code{white-space:nowrap}

  /* 中等宽度收边距，把宽度让给报告里的五列表格（它约要 560px 才不换行） */
  @media(max-width:1500px){ .pane{padding-left:32px;padding-right:32px} }
  /* 再窄就别硬撑两栏了 —— 每栏内容不足 560px 时，正是「挤」的老毛病 */
  @media(max-width:1280px){
    .cap{grid-template-columns:1fr}
    {# 栏仍占满宽（分隔线要通到底），内容靠 .pane>* 的 max-width 限宽居中 #}
    .pane{padding:26px 20px 34px;min-height:0}
    .left{border-right:0;border-bottom:1px solid var(--line)}
    .right{position:static;max-height:none;overflow:visible}
    .phead{min-height:0}
  }
</style>
{% endblock %}

{% block body %}
<div class="cap">

  <div class="pane left">
    <div class="phead">
      <div class="kicker">Step 01 — 取像</div>
      <h2>上传一张火焰照片</h2>
      <div class="hint" style="margin-top:6px">
        拖进下方框、点击选择，或直接 Ctrl+V 粘贴截图。十几秒出结论，结果自动进台账。
      </div>
    </div>

    <div class="fields">
      <div>
        <label for="site">机组 / 位置 — 台账按它归档</label>
        <select id="site" style="min-height:40px;font-size:15px">
          <option value="">请选择…</option>
          {% for s in sites %}<option value="{{ s.id }}">{{ s.label }}</option>{% endfor %}
        </select>
      </div>
      <div id="act-idle"><button id="btn-pick" class="btn primary" style="height:40px">选择照片</button></div>
      <div id="act-preview" hidden style="display:flex;gap:8px">
        <button id="btn-go" class="btn primary" style="height:40px">开始分析</button>
        <button id="btn-reset" class="btn" style="height:40px">换一张</button>
      </div>
      <div id="act-busy" hidden class="busybox" style="height:40px;padding:0 14px">
        <span class="spin"></span><span id="busy-text">分析中</span>
      </div>
    </div>

    <div class="viewport bp" id="drop">
      <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
      <img id="preview" hidden alt="">
      <div class="empty" id="vp-empty">把照片拖到这里<span style="font-size:12px;font-family:var(--b);color:var(--n600)">或点击选择 · 支持 Ctrl+V 粘贴</span></div>
      <div class="guide"></div><div class="cross"></div>
      <div class="foot"><span id="vp-site">未选择机位</span><span id="vp-state" class="tnum">待取像</span></div>
      <div class="stages" id="stages" hidden>
        <div class="st"><i></i><span>上传照片</span><span>待执行</span></div>
        <div class="st"><i></i><span>照片校验</span><span>待执行</span></div>
        <div class="st"><i></i><span>CV 分割与指标</span><span>待执行</span></div>
        <div class="st"><i></i><span>风险判级</span><span>待执行</span></div>
        <div class="st"><i></i><span>生成报告 · 落台账</span><span>待执行</span></div>
        <div class="bar"><i id="bar"></i></div>
      </div>
    </div>

    {# 网页端没有摄像头入口，但脚本共用，保留隐藏的 input #}
    <input id="cam"  type="file" accept="image/*" hidden>
    <input id="pick" type="file" accept="image/*" hidden>

    <div id="err" class="err" hidden></div>

  </div>

  <div class="pane right">
    <div class="phead">
      <div class="kicker">Step 02 — 结论</div>
      <h2>分析结论与历史对照</h2>
      <div class="hint" style="margin-top:6px">
        判级、量化指标摘要和完整报告入口都在这一侧；下方是同机位最近几次的记录。
      </div>
    </div>

    <div id="result" hidden style="display:flex;flex-direction:column;gap:12px">
      <div class="eyebrow">本次结论</div>
      <div class="verdict" id="verdict"></div>
      <div id="act-report" style="display:grid;grid-template-columns:1fr auto;gap:8px">
        <a id="btn-report" class="btn primary" style="height:40px" target="_blank" href="#">查看完整报告</a>
        <button class="btn" style="height:40px" onclick="window.print()">打印</button>
      </div>
      <div class="muted" style="font-size:11px" id="archived"></div>
    </div>

    <div id="summary" class="md bp card" hidden>
      <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
    </div>

    <div id="ph" class="noprint">
      <b>还没有结论</b>
      <span style="font-size:12.5px;text-wrap:pretty;max-width:40ch">左侧选好机位、放入照片并点「开始分析」，结论和指标摘要会显示在这里。</span>
    </div>

    <div class="bp card" style="display:flex;flex-direction:column;gap:10px">
      <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
      <div class="eyebrow">最近在这个机位</div>
      <div class="rowlist" id="recent"><div class="muted">选择机位后显示。</div></div>
    </div>

    <div class="switch" style="margin-top:auto"><a href="/?view=mobile">切换到手机版</a></div>
  </div>

</div>
{% endblock %}

{% block script %}
{% include "_capture_core.j2" %}
{% endblock %}
