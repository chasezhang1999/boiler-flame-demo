<!doctype html>
<html lang="zh-CN"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% block title %}锅炉运行分析助手{% endblock %}</title>
<link rel="stylesheet" href="/assets/fonts/fonts.css">
<style>
  :root{
    --ink:#1d1f20;--muted:#5d5d60;--faint:#98989b;--line:#e3e3e6;--bg:#f6f7f8;
    --accent:#416180;--hi:#e0483a;--mid:#fbaf17;--lo:#22a35c;
    --h:"Barlow Condensed",-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;
    --b:"Barlow",-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 var(--b)}
  h1,h2,h3{font-family:var(--h);font-weight:600;margin:0}

  /* 顶部导航：手机上是主要入口，做成等宽三格好点 */
  nav{display:flex;background:#fff;border-bottom:1px solid var(--line);
      position:sticky;top:0;z-index:10}
  nav a{flex:1;text-align:center;padding:14px 6px;text-decoration:none;
        color:var(--muted);font-family:var(--h);font-size:16px;
        border-bottom:2px solid transparent}
  nav a.on{color:var(--ink);border-bottom-color:var(--accent)}
  main{max-width:860px;margin:0 auto;padding:18px 16px 60px}

  .card{background:#fff;border:1px solid var(--line);padding:18px;margin-bottom:14px}
  label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}
  select,input[type=text],textarea{width:100%;padding:11px 12px;font:15px var(--b);
    border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:0}
  select:focus,input:focus,textarea:focus{outline:2px solid var(--accent);outline-offset:-2px}

  button{font:16px var(--h);font-weight:600;border:0;padding:13px 20px;cursor:pointer;
         background:var(--accent);color:#fff}
  button:disabled{opacity:.5;cursor:default}
  button.ghost{background:#fff;color:var(--accent);border:1px solid var(--line)}
  /* 表格行内的次要操作，别抢主按钮的注意力 */
  table button{font:13px var(--b);padding:5px 10px;background:#fff;
               color:var(--muted);border:1px solid var(--line)}
  table button:hover{color:#922b21;border-color:#f3c4bf;background:#fdedec}
  .row{display:flex;gap:10px;flex-wrap:wrap}
  .row>*{flex:1;min-width:120px}

  .lv{display:inline-block;font-family:var(--h);font-weight:600;padding:2px 10px;color:#fff}
  .lv.高{background:var(--hi)}.lv.中{background:var(--mid);color:#1d1f20}
  .lv.低{background:var(--lo)}.lv.未知{background:#7a7a7d}

  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{border-bottom:1px solid var(--line);padding:9px 6px;text-align:left}
  th{font-family:var(--h);font-size:12px;letter-spacing:.06em;color:var(--muted)}
  td.num{text-align:right;font-variant-numeric:tabular-nums}
  a{color:var(--accent)}
  .muted{color:var(--muted);font-size:13px}
  .err{background:#fdedec;border:1px solid #f3c4bf;color:#922b21;padding:10px 12px;
       font-size:14px;margin-top:10px}
  .spin{display:inline-block;width:14px;height:14px;border:2px solid #fff;
        border-top-color:transparent;border-radius:50%;animation:s .8s linear infinite;
        vertical-align:-2px;margin-right:6px}
  @keyframes s{to{transform:rotate(360deg)}}

  /* markdown 渲染出来的内容 */
  .md h1{font-size:22px;margin:4px 0 8px}
  .md h2{font-size:17px;margin:18px 0 8px;padding-bottom:5px;border-bottom:1px solid var(--line)}
  .md ul,.md ol{margin:8px 0;padding-left:20px}
  .md li{margin:4px 0}
  .md blockquote{margin:10px 0;padding:10px 14px;background:#eef3f7;
                 border-left:3px solid var(--accent);font-size:14px}
  .md blockquote p{margin:4px 0}
  .md img{max-width:100%;border:1px solid var(--line);display:block;margin:8px 0}
  .md table{margin:10px 0}
  .md code{background:#eef0f2;padding:1px 5px;font-size:13px}
  .md em{color:var(--muted);font-style:normal;font-size:13px}
  .md hr{border:0;border-top:1px solid var(--line);margin:16px 0}
</style></head><body>

<nav>
  <a href="/"        class="{% if page=='capture' %}on{% endif %}">拍照分析</a>
  <a href="/history" class="{% if page=='history' %}on{% endif %}">历史台账</a>
  <a href="/chat"    class="{% if page=='chat' %}on{% endif %}">历史问答</a>
</nav>

<main>{% block body %}{% endblock %}</main>

<script>
// 极简 markdown 渲染。不引 CDN：国内网络不稳，而且报告要能离线打开。
// 只覆盖服务端会生成的那几种语法，不求通用。
function md2html(s){
  s = String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const lines = s.split('\n'), out = [];
  let i = 0;
  const inline = t => t
    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img alt="$1" src="$2">')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>');
  while (i < lines.length){
    let l = lines[i];
    if (/^\s*$/.test(l)) { i++; continue; }
    if (/^---+$/.test(l.trim())) { out.push('<hr>'); i++; continue; }
    let m = l.match(/^(#{1,4})\s+(.*)$/);
    if (m){ const n=m[1].length; out.push('<h'+n+'>'+inline(m[2])+'</h'+n+'>'); i++; continue; }
    if (/^&gt;/.test(l)){                       // 引用块，内部可能还有列表
      const buf=[];
      while(i<lines.length && /^&gt;/.test(lines[i])){ buf.push(lines[i].replace(/^&gt;\s?/,'')); i++; }
      out.push('<blockquote>'+md2html(buf.join('\n'))+'</blockquote>'); continue;
    }
    if (/^\|/.test(l)){                         // 表格
      const rows=[];
      while(i<lines.length && /^\|/.test(lines[i])){ rows.push(lines[i]); i++; }
      const cells = r => r.split('|').slice(1,-1).map(c=>c.trim());
      const head = cells(rows[0]);
      const body = rows.slice(rows[1] && /^[\s|:-]+$/.test(rows[1]) ? 2 : 1);
      out.push('<table><thead><tr>'+head.map(c=>'<th>'+inline(c)+'</th>').join('')+
        '</tr></thead><tbody>'+body.map(r=>'<tr>'+cells(r).map(c=>'<td>'+inline(c)+'</td>').join('')+'</tr>').join('')+
        '</tbody></table>');
      continue;
    }
    if (/^\s*[-*]\s+/.test(l) || /^\s*\d+\.\s+/.test(l)){
      const ol = /^\s*\d+\./.test(l), items=[];
      while(i<lines.length && (/^\s*[-*]\s+/.test(lines[i]) || /^\s*\d+\.\s+/.test(lines[i]))){
        items.push(lines[i].replace(/^\s*(?:[-*]|\d+\.)\s+/,'')); i++;
      }
      out.push('<'+(ol?'ol':'ul')+'>'+items.map(t=>'<li>'+inline(t)+'</li>').join('')+'</'+(ol?'ol':'ul')+'>');
      continue;
    }
    const buf=[];
    while(i<lines.length && !/^\s*$/.test(lines[i]) && !/^[|#>]|^\s*[-*]\s|^\s*\d+\.\s/.test(lines[i])){
      buf.push(lines[i]); i++;
    }
    out.push('<p>'+inline(buf.join(' '))+'</p>');
  }
  return out.join('');
}
function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
</script>
{% block script %}{% endblock %}
</body></html>
