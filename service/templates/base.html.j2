<!doctype html>
<html lang="zh-CN"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% block title %}炉智检{% endblock %}</title>
<link rel="icon" href="/assets/logo.png">
<link rel="stylesheet" href="/assets/fonts/fonts.css">
<style>
  /* Industry：钢蓝 + 线框。方角、发丝描边、卡片四角十字标记。 */
  :root{
    --ink:#1d1f20;--muted:#5d5d60;--faint:#98989b;
    --line:rgba(29,31,32,.16);--line-soft:rgba(29,31,32,.08);
    --bg:#fff;--tint:rgba(29,31,32,.03);
    --accent:#5980a6;--accent-100:#eef6ff;--accent-300:#b5d9fd;--accent-600:#597ea3;--accent-700:#416180;
    --n100:#f5f5f8;--n200:#e7e7ea;--n300:#d4d4d7;--n600:#7a7a7d;--n700:#5d5d60;--n800:#424244;
    --hi:#e0483a;--mid:#fbaf17;--lo:#22a35c;
    --h:"Barlow Condensed",-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;
    --b:"Barlow",-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;
  }
  *,*::before,*::after{box-sizing:border-box}
  [hidden]{display:none!important}   /* 内联 display 会盖掉 hidden 属性，这里钉死 */
  body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 var(--b)}
  h1,h2,h3,h4{font-family:var(--h);font-weight:600;line-height:1.12;letter-spacing:-.015em;margin:0}
  a{color:var(--accent-700);text-underline-offset:3px}
  a:hover{color:#2c455d}
  :focus{outline:none}
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  ::selection{background:rgba(89,128,166,.3)}
  .muted{color:var(--n700);font-size:13px}
  .nowrap{white-space:nowrap}
  .tnum{font-variant-numeric:tabular-nums}

  /* 线框对象：方角 + 发丝边 + 四角十字标记 */
  .bp{position:relative;border:1px solid var(--line);background:transparent}
  .bp>i.c{position:absolute;width:11px;height:11px;color:rgba(29,31,32,.55)}
  .bp>i.c::before,.bp>i.c::after{content:"";position:absolute;background:currentColor}
  .bp>i.c::before{left:5px;top:0;width:1px;height:100%}
  .bp>i.c::after{top:5px;left:0;width:100%;height:1px}
  .bp>i.tl{top:-6px;left:-6px}.bp>i.tr{top:-6px;right:-6px}
  .bp>i.bl{bottom:-6px;left:-6px}.bp>i.br{bottom:-6px;right:-6px}

  /* 顶部导航 */
  nav{display:flex;align-items:stretch;background:var(--bg);
      border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
  .brand{display:flex;align-items:center;gap:10px;padding:0 20px;
         border-right:1px solid var(--line);white-space:nowrap}
  .brand img{width:24px;height:24px;display:block;flex:none}
  .brand b{font-family:var(--h);font-weight:600;font-size:19px;letter-spacing:.02em}
  nav .tabs{display:flex}
  nav .tabs a{display:flex;align-items:center;padding:14px 20px;text-decoration:none;white-space:nowrap;
      font-family:var(--h);font-weight:600;font-size:15px;color:var(--n600);
      border-right:1px solid var(--line);border-bottom:2px solid transparent}
  nav .tabs a:hover{background:rgba(89,128,166,.08);color:var(--ink)}
  nav .tabs a.on{color:var(--ink);border-bottom-color:var(--accent);background:rgba(89,128,166,.08)}
  nav .status{margin-left:auto;display:flex;align-items:center;gap:16px;padding:0 20px;
              font-family:var(--h);font-size:13px;letter-spacing:.06em;color:var(--n700);
              white-space:nowrap;overflow:hidden}

  .kicker{font-family:var(--h);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-700)}
  .eyebrow{font-family:var(--h);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--n600)}

  /* 控件 */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;
       font-family:var(--h);font-weight:600;font-size:14px;line-height:1.2;cursor:pointer;
       padding:8px 14px;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:0}
  .btn:hover{background:rgba(29,31,32,.07)}
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .btn.primary:hover{background:var(--accent-600)}
  .btn.primary:active{background:var(--accent-700)}
  .btn.lg{height:44px;font-size:15px}
  .chip{border:1px solid var(--line);background:transparent;color:var(--n700);
        padding:3px 10px;font-size:12px;font-family:var(--h);cursor:pointer;white-space:nowrap}
  .chip:hover{border-color:var(--accent);color:var(--accent-700)}
  .chip.on{background:var(--accent);border-color:var(--accent);color:#fff}
  .cell{border:1px solid var(--line);padding:11px 4px;text-align:center;cursor:pointer;
        font-family:var(--h);font-weight:600;font-size:15px;background:transparent;color:var(--ink)}
  .cell:hover{background:rgba(89,128,166,.08)}
  .cell.on{background:var(--accent);border-color:var(--accent);color:#fff}
  label{display:block;font-size:12px;color:var(--n700);margin-bottom:5px}
  select,input[type=text],textarea{width:100%;padding:8px 10px;font:14px var(--b);color:var(--ink);
    border:1px solid var(--line);background:transparent;border-radius:0;caret-color:var(--accent)}
  select:hover,textarea:hover{border-color:rgba(29,31,32,.45)}
  textarea{resize:vertical}

  .lv{display:inline-block;font-family:var(--h);font-weight:600;font-size:12px;
      letter-spacing:.04em;padding:1px 9px;color:#fff;white-space:nowrap}
  .lv.高{background:var(--hi)}.lv.中{background:var(--mid);color:var(--ink)}
  .lv.低{background:var(--lo)}.lv.未知{background:var(--n600)}

  table{width:100%;border-collapse:collapse;font-size:14px}
  th{text-align:left;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--n700);
     padding:7px;border-bottom:1px solid var(--line);white-space:nowrap}
  td{padding:7px;border-bottom:1px solid var(--line-soft)}
  tbody tr:hover{background:rgba(29,31,32,.04)}

  .err{border:1px solid #f3c4bf;background:#fdedec;color:#922b21;padding:10px 12px;font-size:14px}
  .spin{display:inline-block;width:13px;height:13px;border:2px solid var(--accent);
        border-top-color:transparent;border-radius:50%;animation:s .8s linear infinite;vertical-align:-2px}
  @keyframes s{to{transform:rotate(360deg)}}
  @keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}

  /* markdown */
  .md h1{font-size:22px;margin:4px 0 8px;font-family:var(--h)}
  .md h2{font-size:17px;margin:16px 0 8px;padding-bottom:5px;border-bottom:1px solid var(--line);font-family:var(--h)}
  .md p{margin:8px 0}
  .md ul,.md ol{margin:8px 0;padding-left:20px}
  .md li{margin:4px 0}
  .md blockquote{margin:10px 0;padding:10px 14px;background:var(--accent-100);
                 border-left:2px solid var(--accent);font-size:14px}
  .md img{max-width:100%;border:1px solid var(--line);display:block;margin:8px 0}
  .md code{background:var(--n100);padding:1px 5px;font-size:13px}
  .md em{color:var(--n700);font-style:normal;font-size:13px}
  .md hr{border:0;border-top:1px solid var(--line);margin:16px 0}

  @media print{.noprint{display:none!important}nav{display:none}}

  /* ── 拍照页共用：取景框 / 进度 / 结论条（手机版和网页版都用这套） ── */
  .viewport{position:relative;aspect-ratio:3/4;border:1px solid var(--line);overflow:hidden;background:var(--n200)}
  .viewport img{width:100%;height:100%;object-fit:cover;display:block}
  .viewport .guide{position:absolute;inset:12px;border:1px dashed rgba(255,255,255,.45);pointer-events:none}
  .viewport .cross{position:absolute;left:50%;top:50%;width:34px;height:34px;transform:translate(-50%,-50%);pointer-events:none}
  .viewport .cross::before{content:"";position:absolute;left:16px;top:0;bottom:0;width:1px;background:rgba(255,255,255,.7)}
  .viewport .cross::after{content:"";position:absolute;top:16px;left:0;right:0;height:1px;background:rgba(255,255,255,.7)}
  .viewport .foot{position:absolute;left:0;right:0;bottom:0;padding:8px 10px;color:#fff;font-size:11px;
                  display:flex;justify-content:space-between;gap:10px;background:linear-gradient(transparent,rgba(0,0,0,.6))}
  .viewport .empty{position:absolute;inset:0;display:flex;flex-direction:column;gap:6px;align-items:center;
                   justify-content:center;color:var(--n600);font-family:var(--h);font-size:15px;text-align:center;padding:20px}
  .stages{position:absolute;inset:0;background:rgba(29,31,32,.72);display:flex;flex-direction:column;
          justify-content:flex-end;padding:16px;gap:10px}
  .stages .st{display:grid;grid-template-columns:18px 1fr auto;gap:8px;align-items:center;color:#fff;font-size:12px;opacity:.4}
  .stages .st.on,.stages .st.done{opacity:1}
  .stages .st i{display:block;width:9px;height:9px;justify-self:center;border:1px solid rgba(255,255,255,.45)}
  .stages .st.on i{background:#fff;border-color:var(--accent-300);animation:pulse 1s infinite}
  .stages .st.done i{background:var(--accent-300);border-color:var(--accent-300)}
  .stages .st span:last-child{font-size:11px;color:rgba(255,255,255,.7);font-variant-numeric:tabular-nums}
  .bar{height:2px;background:rgba(255,255,255,.25);margin-top:4px}
  .bar i{display:block;height:2px;background:var(--accent-300);width:8%;transition:width .4s}
  .verdict{border:1px solid var(--line);display:flex;flex-direction:column}
  .verdict .top{display:flex;align-items:stretch}
  .verdict .badge{display:flex;align-items:center;padding:0 12px;font-family:var(--h);font-weight:600;font-size:16px;color:#fff}
  .verdict .badge.中{color:var(--ink)}
  .verdict .mid{padding:8px 10px;flex:1;min-width:0}
  .rowlist .r{display:grid;grid-template-columns:100px 46px minmax(0,1fr) auto;gap:12px;align-items:center;
              padding:9px 0;border-bottom:1px solid var(--line-soft);font-size:13px}
  .rowlist .r:last-child{border-bottom:0}
  .rowlist .r .t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--n800)}
  .busybox{display:flex;align-items:center;justify-content:center;gap:8px;height:44px;
           border:1px solid var(--line);font-family:var(--h);font-size:15px;color:var(--n700)}
  @media(max-width:900px){
    nav .status{display:none}
    .brand{padding:0 12px}
    nav .tabs a{padding:14px 12px;font-size:14px}
  }
</style>
{% block head %}{% endblock %}
</head><body>

<nav class="noprint">
  <div class="brand"><img src="/assets/logo.png" alt="炉智检"><b>炉智检</b></div>
  <div class="tabs">
    <a href="/"        class="{% if page=='capture' %}on{% endif %}">拍照分析</a>
    <a href="/history" class="{% if page=='history' %}on{% endif %}">历史台账</a>
    <a href="/chat"    class="{% if page=='chat' %}on{% endif %}">智能问答</a>
  </div>
  <div class="status">第 9 组 · 智汇新阳</div>
</nav>

{% block body %}{% endblock %}

<script>
// 极简 markdown 渲染。不引 CDN：国内网络不稳，而且报告要能离线打开。
function md2html(s){
  s = String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const lines = s.split('\n'), out = [];
  let i = 0;
  const inline = t => t
    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img alt="$1" src="$2">')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>');
  while (i < lines.length){
    let l = lines[i];
    if (/^\s*$/.test(l)) { i++; continue; }
    if (/^---+$/.test(l.trim())) { out.push('<hr>'); i++; continue; }
    let m = l.match(/^(#{1,4})\s+(.*)$/);
    if (m){ const n=m[1].length; out.push('<h'+n+'>'+inline(m[2])+'</h'+n+'>'); i++; continue; }
    if (/^&gt;/.test(l)){
      const buf=[];
      while(i<lines.length && /^&gt;/.test(lines[i])){ buf.push(lines[i].replace(/^&gt;\s?/,'')); i++; }
      out.push('<blockquote>'+md2html(buf.join('\n'))+'</blockquote>'); continue;
    }
    if (/^\|/.test(l)){
      const rows=[];
      while(i<lines.length && /^\|/.test(lines[i])){ rows.push(lines[i]); i++; }
      const cells = r => r.split('|').slice(1,-1).map(c=>c.trim());
      const head = cells(rows[0]);
      const body = rows.slice(rows[1] && /^[\s|:-]+$/.test(rows[1]) ? 2 : 1);
      out.push('<table><thead><tr>'+head.map(c=>'<th>'+inline(c)+'</th>').join('')+
        '</tr></thead><tbody>'+body.map(r=>'<tr>'+cells(r).map(c=>'<td>'+inline(c)+'</td>').join('')+'</tr>').join('')+
        '</tbody></table>');
      continue;
    }
    if (/^\s*[-*]\s+/.test(l) || /^\s*\d+\.\s+/.test(l)){
      const ol = /^\s*\d+\./.test(l), items=[];
      while(i<lines.length && (/^\s*[-*]\s+/.test(lines[i]) || /^\s*\d+\.\s+/.test(lines[i]))){
        items.push(lines[i].replace(/^\s*(?:[-*]|\d+\.)\s+/,'')); i++;
      }
      out.push('<'+(ol?'ol':'ul')+'>'+items.map(t=>'<li>'+inline(t)+'</li>').join('')+'</'+(ol?'ol':'ul')+'>');
      continue;
    }
    const buf=[];
    while(i<lines.length && !/^\s*$/.test(lines[i]) && !/^[|#>]|^\s*[-*]\s|^\s*\d+\.\s/.test(lines[i])){
      buf.push(lines[i]); i++;
    }
    out.push('<p>'+inline(buf.join(' '))+'</p>');
  }
  return out.join('');
}
// 统一的接口调用：后端 5xx 时反代返回的是 HTML 错误页，直接 r.json()
// 会抛 "Unexpected token '<'"，把真实原因盖掉。这里先取文本再试解析。
async function api(url, opts){
  const r = await fetch(url, opts);
  const text = await r.text();
  let data = null;
  try { data = JSON.parse(text); } catch (e) { /* 不是 JSON，往下走 */ }
  if (!r.ok) {
    if (data && data.detail) throw new Error(data.detail);
    if (r.status === 502 || r.status === 504)
      throw new Error('后端无响应或超时（HTTP ' + r.status + '）。若刚改过配置，等容器重启完再试。');
    throw new Error('HTTP ' + r.status + '：' + text.replace(/<[^>]*>/g, ' ').trim().slice(0, 120));
  }
  if (data === null) throw new Error('后端返回的不是 JSON：' + text.slice(0, 120));
  return data;
}
function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
const $ = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));
function corners(){ return '<i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>'; }
</script>
{% block script %}{% endblock %}
</body></html>
